@@ -0,0 +1,18 @@
+# 중앙 서비스 네임스페이스 (Pod Security baseline 강제)
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: coldguard
+  labels:
+    app.kubernetes.io/part-of: coldguard
+    pod-security.kubernetes.io/enforce: baseline
+---
+# 모니터링 에이전트 네임스페이스
+# Fluent Bit가 노드의 /var/log(hostPath)를 읽어야 해서 privileged로 둔다.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: monitoring
+  labels:
+    app.kubernetes.io/part-of: coldguard
+    pod-security.kubernetes.io/enforce: privileged
diff --git a/infra/aws/base/resource-limits.yaml b/infra/aws/base/resource-limits.yaml
new file mode 100644
index 0000000..6ab5dfb
--- /dev/null
+++ b/infra/aws/base/resource-limits.yaml
@@ -0,0 +1,32 @@
+# t3.medium 3대(할당 가능 약 CPU 5.7, 메모리 10Gi) 안에서 coldguard 네임스페이스가 쓸 상한
+# argocd, tailscale, monitoring, kube-system은 포함하지 않는다.
+apiVersion: v1
+kind: ResourceQuota
+metadata:
+  name: coldguard-quota
+  namespace: coldguard
+spec:
+  hard:
+    requests.cpu: "3"
+    requests.memory: 6Gi
